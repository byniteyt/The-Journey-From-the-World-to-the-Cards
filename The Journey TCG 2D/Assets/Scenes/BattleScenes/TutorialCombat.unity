  dialoguePanel: {fileID: 181919170}
  dialogues:
  - dialogue: "Esto de aqu\xED es tu vida"
    image: {fileID: 2078154881}
    action:
      m_PersistentCalls:
        m_Calls: []
  - dialogue: "Esto de aqu\xED es la vida del enemigo"
    image: {fileID: 392283593}
    action:
      m_PersistentCalls:
        m_Calls: []
  - dialogue: "Esto de aqu\xED es el man\xE1.\\nLo consumir\xE1s para jugar cartas
      y cada turno recibes 4 hasta tener un m\xE1ximo de 10."
    image: {fileID: 1193365575}
    action:
      m_PersistentCalls:
        m_Calls: []
  - dialogue: "\xDAsalo sabiamente y no lo malgastes o la partida se podr\xE1 volver
      en tu contra. "
    image: {fileID: 1193365575}
    action:
      m_PersistentCalls:
        m_Calls: []
  - dialogue: Eso es todo, probemos ahora el combate.\n Haz click sobre Sappy
    image: {fileID: 0}
    action:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1073797805}
